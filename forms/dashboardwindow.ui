    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
    color: #333;
}

#tabWidget ::pane {
    border: 1px solid #87CEEB;
    border-radius: 8px;
    padding: 10px;
    background: #f0f8ff;
}

QTabBar::tab {
    background: #add8e6;
    border: 1px solid #87CEEB;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    color: #333;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-color: #4682B4;
    color: #000;
}

QTabBar::tab:hover {
    background: #87CEFA;
    color: #111;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}</string>
